    """A c2sp.org/tlog-witness witness: hand it the body of each
    ``POST /add-checkpoint`` and send back what it returns."""

    @staticmethod
    def new(
        key_name: str,
        signing_seed: bytes,
        state_path: Optional[str] = None,
        open_enrollment: bool = False,
        max_logs: int = 100_000,
    ) -> WitnessService: ...
    @staticmethod
    def create_state(path: str) -> None: ...
    def vkey(self) -> str: ...
    def pubkey_hex(self) -> str: ...
    def add_log(self, origin: str, log_vkey: str) -> bool: ...
    def handle_add_checkpoint(self, body: str, now_unix_seconds: Optional[int] = None) -> tuple[int, str]: ...
    def handle_add_checkpoint_http(
        self, body: str, now_unix_seconds: Optional[int] = None
    ) -> tuple[int, str, str]: ...
    def log_count(self) -> int: ...

def verify_dossier_json(
    dossier_json: str,
    threshold: float,
    expected_identity_pubkey: Optional[str] = None,
    trusted_directory_json: Optional[str] = None,
    min_witnesses: Optional[int] = None,
    revocations_json: Optional[str] = None,
    known_heads: Optional[list[str]] = None,
    evidence_json: Optional[str] = None,
) -> str:
    """The reference verifier's report as JSON (``witness-log verify --json``'s
    ``report``). ``verdict`` is one of witnessed, consistent_unwitnessed,
    unanchored, diverged (contradicts a ``known_heads`` entry or verified
    ``evidence_json``), invalid (a check failed). ``split_view_unsafe`` is
    true for a witnessed verdict whose cosigners are not a strict majority
    of the directory: the CLI exits 11 for it by default."""
    ...
def verify_inclusion(
    leaf_hash_hex: str, leaf_index: int, tree_size: int, proof_hexes: list[str], root_hex: str
) -> bool: ...
def payload_hash(payload: bytes, salt: bytes, index: int) -> str:
    """SPEC §8: ``SHA256(bucket_pad(payload) || salt || index)``, hex."""
def verify_handoff_binding(
    sender_identity_hex: str, sender_leaf_json: str, receiver_identity_hex: str, receiver_leaf_json: str
) -> bool:
    """True when the Sent/Received pair binds (SPEC §3.1). The reason for a
    failure is ``handoff_binding_error``. Until 0.4.0 this returned ``None``
    on success and the reason on failure."""
def handoff_binding_error(
    sender_identity_hex: str, sender_leaf_json: str, receiver_identity_hex: str, receiver_leaf_json: str
) -> Optional[str]:
    """``None`` when the pair binds, else why not."""
def verify_authorization_binding(
    party_a_identity_hex: str, party_a_leaf_json: str, party_b_identity_hex: str, party_b_leaf_json: str
) -> bool:
    """True when the AuthorizationEvent pair binds (SPEC §3.2)."""
def authorization_binding_error(
    party_a_identity_hex: str, party_a_leaf_json: str, party_b_identity_hex: str, party_b_leaf_json: str
) -> Optional[str]:
    """``None`` when the pair binds, else why not."""
