"""Type stubs for the Rust extension ``witness_log._core``.

Hand-maintained; kept in step with ``crates/witness-log-python/src/lib.rs``
by ``tests/test_stubs.py``. Every ``*_json`` method returns a JSON string
whose shape is documented in ``spec/SPEC.md`` and ``spec/dossier.schema.json``.
"""

from __future__ import annotations

from typing import Any, Optional

class WitnessLogError(Exception):
    """Base class for all WitnessLog-specific errors."""

class SignatureError(WitnessLogError):
    """A cryptographic signature failed to verify."""

class ContinuityError(WitnessLogError):
    """A checkpoint's signature is valid but doesn't match this log's actual state."""

class MalformedError(WitnessLogError):
    """Input was malformed (wrong size, bad hex, unparsable)."""

class WitnessLog:
    """An in-memory log. Salts are not persisted; use ``JournaledLog`` for
    anything that must survive a restart."""

    @staticmethod
    def generate() -> WitnessLog: ...
    @staticmethod
    def resume(identity_seed: bytes, session_number: int) -> WitnessLog: ...
    @staticmethod
    def resume_with_ttl(identity_seed: bytes, session_number: int, ttl_ms: int) -> WitnessLog: ...
    @staticmethod
    def load_snapshot(path: str) -> WitnessLog: ...
    def identity_pubkey_hex(self) -> str: ...
    def identity_bytes(self) -> bytes: ...
    def append_intent(self, payload: bytes) -> int: ...
    def append_result(self, payload: bytes) -> int: ...
    def append_memory(self, payload: bytes) -> int: ...
    def forget(self, leaf_index: int) -> bool: ...
    def tree_size(self) -> int: ...
    def root_hex(self) -> str: ...
    def leaves_json(self) -> str: ...
    def checkpoint(self) -> str: ...
    def verify_continuity(self, checkpoint_json: str) -> None: ...
    def c2sp_checkpoint_text(self, origin: str) -> str: ...
    def sign_c2sp_checkpoint(self, origin: str) -> str: ...
    def c2sp_vkey(self, origin: str) -> str: ...
    def all_bindings_json(self) -> str: ...
    def canonical_origin(self) -> str: ...
    def add_checkpoint_body(self, old_size: int = 0) -> str: ...
    def dossier_from_responses(self, responses: list[tuple[str, str]]) -> tuple[str, int]: ...
    def add_checkpoint_body_at(self, size: int, old_size: int = 0) -> str: ...
    def dossier_from_responses_at(self, size: int, responses: list[tuple[str, str]]) -> tuple[str, int]: ...
    def root_hex_at(self, size: int) -> Optional[str]: ...
    def inclusion_proof(self, index: int) -> Optional[tuple[int, str, list[str]]]: ...
    def leaf_hash_hex(self, index: int) -> Optional[str]: ...
    def to_dossier_json(self) -> str: ...
    def save_snapshot(self, path: str) -> None: ...
    # Attached by ``witness_log/__init__.py``; ``state_path`` is required
    # for an in-memory log.
    def submit(
        self,
        directory: Any,
        want: Optional[int] = None,
        min: Optional[int] = None,
        *,
        timeout: float = 10.0,
        state_path: Optional[str] = None,
    ) -> dict[str, Any]: ...
    async def asubmit(
        self,
        directory: Any,
        want: Optional[int] = None,
        min: Optional[int] = None,
        *,
        timeout: float = 10.0,
        state_path: Optional[str] = None,
    ) -> dict[str, Any]: ...

class JournaledLog:
    """A log whose every append lands in ``path`` (one JSON line per leaf)
    with redaction salts in ``<path>.salts``. Both files hold key-grade
    material and are created 0600."""

    @staticmethod
    def create(path: str, identity_seed: bytes) -> JournaledLog: ...
    @staticmethod
    def create_sealed(path: str, identity_seed: bytes) -> JournaledLog: ...
    @staticmethod
    def create_ephemeral(path: str) -> JournaledLog: ...
    @staticmethod
    def resume(path: str) -> tuple[JournaledLog, int]: ...
    @staticmethod
    def resume_with_identity(path: str, identity_seed: bytes) -> tuple[JournaledLog, int]: ...
    @staticmethod
    def force_unlock(path: str) -> None: ...
    def append_intent(self, payload: bytes) -> int: ...
    def append_result(self, payload: bytes) -> int: ...
    def append_memory(self, payload: bytes) -> int: ...
    def append_handoff_sent(self, state: bytes, counterparty_pubkey_hex: str) -> int: ...
    def append_handoff_received(self, state: bytes, counterparty_pubkey_hex: str) -> int: ...
    def append_authorization_event(self, kind: str, scope: bytes, counterparty_pubkey_hex: str) -> int: ...
    def append_external_anchor(self, anchor_url: str, anchor_proof_json: str) -> int: ...
    def forget(self, index: int) -> bool: ...
    def can_forget(self, index: int) -> bool: ...
    def sync(self) -> None: ...
    def tree_size(self) -> int: ...
    def root_hex(self) -> str: ...
    def identity_pubkey_hex(self) -> str: ...
    def identity_bytes(self) -> bytes: ...
    def checkpoint(self) -> str: ...
    def to_dossier_json(self) -> str: ...
    def c2sp_checkpoint_text(self, origin: str) -> str: ...
    def sign_c2sp_checkpoint(self, origin: str) -> str: ...
    def c2sp_vkey(self, origin: str) -> str: ...
    def canonical_origin(self) -> str: ...
    def add_checkpoint_body(self, old_size: int = 0) -> str: ...
    def dossier_from_responses(self, responses: list[tuple[str, str]]) -> tuple[str, int]: ...
    def add_checkpoint_body_at(self, size: int, old_size: int = 0) -> str: ...
    def dossier_from_responses_at(self, size: int, responses: list[tuple[str, str]]) -> tuple[str, int]: ...
    def root_hex_at(self, size: int) -> Optional[str]: ...
    def inclusion_proof(self, index: int) -> Optional[tuple[int, str, list[str]]]: ...
    def leaf_hash_hex(self, index: int) -> Optional[str]: ...
    def leaves_json(self) -> str: ...
    def leaf_json(self, index: int) -> Optional[str]: ...
    def path(self) -> str: ...
    def salt_hex(self, index: int) -> Optional[str]: ...
    def enable_payload_store(self, path: Optional[str] = None) -> None: ...
    def payload_store_path(self) -> Optional[str]: ...
    def payload(self, index: int) -> Optional[bytes]: ...
    def close(self) -> None: ...
    # Attached by ``witness_log/__init__.py`` (Python, not Rust); listed
    # here because they are methods of this class at runtime.
    def disclose(self, index: int) -> dict[str, Any]: ...
    def revoke_json(
        self,
        reason: str,
        as_of_ms: Optional[int] = None,
        as_of_index: Optional[int] = None,
        experimental: bool = False,
    ) -> str:
        """Sign a revocation of this identity (SPEC §5); `as_of_index` is RFC-0005 and needs `experimental=True`."""
    def witnessed_dossier_json(self, state_path: Optional[str] = None) -> Optional[str]:
        """Dossier for the latest cosigned head, with its receipts, rebuilt
        from ``<journal>.witnesses.json`` (attached in ``__init__``)."""
    def submit(
        self,
        directory: Any,
        want: Optional[int] = None,
        min: Optional[int] = None,
        *,
        timeout: float = 10.0,
        state_path: Optional[str] = None,
    ) -> dict[str, Any]: ...
    async def asubmit(
        self,
        directory: Any,
        want: Optional[int] = None,
        min: Optional[int] = None,
        *,
        timeout: float = 10.0,
        state_path: Optional[str] = None,
    ) -> dict[str, Any]: ...
    def is_closed(self) -> bool: ...
    def __enter__(self) -> JournaledLog: ...
    def __exit__(self, exc_type: object, exc: object, tb: object) -> bool: ...

