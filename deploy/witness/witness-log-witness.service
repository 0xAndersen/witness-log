# systemd unit for a witness-log witness.
#
#   sudo useradd --system --home /var/lib/witness-log --shell /usr/sbin/nologin witness-log
#   sudo install -d -o witness-log -g witness-log -m 0700 /var/lib/witness-log
#   sudo install -m 0755 witness-log /usr/local/bin/witness-log
#   sudo -u witness-log witness-log witness init /var/lib/witness-log/w1 \
#        --name witness.example/w1 --org "Example Org" --url https://witness.example --compute hetzner
#   sudo install -m 0644 witness-log-witness.service /etc/systemd/system/
#   sudo systemctl enable --now witness-log-witness
#
# Put a TLS-terminating reverse proxy in front (Caddy, nginx) and raise the
# per-IP limits below to match, since every client then shares the proxy's
# address. See OPERATORS.md.

[Unit]
Description=witness-log witness (c2sp.org/tlog-witness)
Documentation=https://github.com/0xAndersen/witness-log/blob/main/deploy/witness/OPERATORS.md
After=network-online.target
Wants=network-online.target

[Service]
User=witness-log
Group=witness-log
ExecStart=/usr/local/bin/witness-log witness serve /var/lib/witness-log/w1 \
    --listen 127.0.0.1:7380 --open-enrollment \
    --max-conns-per-ip 256 --enroll-rate 6000
Restart=always
RestartSec=2
# SIGTERM releases the lock cleanly; after SIGKILL the next start recovers it.
KillSignal=SIGTERM
TimeoutStopSec=10

# Hardening. The state directory is the only writable path.
StateDirectory=witness-log
ReadWritePaths=/var/lib/witness-log
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
