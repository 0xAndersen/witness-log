# Build artifacts
/target
**/target
*.pyc
__pycache__/
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/
*.so
*.whl
target/wheels/
.DS_Store

# Fuzz corpus and crash artifacts. A crash artifact the fuzz workflow
# uploads and someone accidentally commits is a public zero-day against
# this project's own verifier -- see the pre-launch review, finding 28.
fuzz/artifacts/
fuzz/corpus/

# Private key material. save_snapshot()/LeafJournal both write the raw
# Ed25519 identity seed in plaintext to whatever path the caller gives
# them -- these are exactly the files the README instructs users to
# persist, and exactly the files that must never end up in version
# control. See the pre-launch review, finding 28.
*.key
*.pem
*.seed
*-snapshot.json
snapshot*.json
*.jsonl
*.wlog
# A journal's sidecars: payload salts (with them, low-entropy payloads can
# be brute-forced and `forget` is undone), stored payloads, witnessing
# state and lock files.
*.salts
*.payloads
*.witnesses.json
*.witnessed.json
*.lock
!Cargo.lock
!package-lock.json
# Environment files: the docs suggest keeping a sealed journal's seed in
# the environment.
.env
.env.*
.envrc
!corpus/*.json

# Local agent/editor working directories and virtualenvs.
.claude/
.venv*/

# JavaScript packages (clients/): installed dependencies, compiled output
# and the napi-rs artefacts generated by `napi build` (the loader, its
# declarations and the per-platform .node binaries).
node_modules/
clients/node/native/

# browser verifier build output
web/pkg/
web/pkg-go/
web/test/_tampered.json
