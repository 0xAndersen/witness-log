{
  "name": "@witness-log/ai-sdk",
  "version": "0.1.0",
  "description": "witness-log for the Vercel AI SDK (v5): witnessTools wraps tool execution in intent/result leaves, witnessMiddleware records tool calls at the model boundary, witnessTelemetry exports the AI SDK's OpenTelemetry spans as leaves.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xAndersen/witness-log.git",
    "directory": "clients/ai-sdk"
  },
  "homepage": "https://github.com/0xAndersen/witness-log/tree/main/clients/ai-sdk",
  "keywords": [
    "ai-sdk",
    "vercel",
    "audit-log",
    "ai-agents",
    "merkle",
    "opentelemetry"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@witness-log/node": "^0.1.0"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "ai": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "2.0.5",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@types/node": "^22.20.5",
    "ai": "5.0.273",
    "typescript": "5.9.3",
    "zod": "^4.1.8"
  }
}
